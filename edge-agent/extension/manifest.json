{
  "manifest_version": 3,
  "name": "Trading V2 Agent",
  "version": "0.1.0",
  "description": "Local control panel for the Trading V2 coding agent.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trading V2 Agent"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ]
}
